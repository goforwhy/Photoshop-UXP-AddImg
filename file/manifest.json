{
  "id": "cn.gapsun.hanxi.addimg",
  "name": "导入器",
  "version": "1.0.3",
  "author": "寒隙",
  "description": "常用图片快速置入工具，点击即可置入",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "request",
    "launchProcess": {
      "schemes": ["https", "http"]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "vanilla",
      "minimumSize": {
        "width": 200,
        "height": 100
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 230,
        "height": 400
      },
      "preferredFloatingSize": {
        "width": 230,
        "height": 400
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
          "species": ["panel"]
        }
      ],
      "label": {
        "default": "导入器"
      }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ]
}
