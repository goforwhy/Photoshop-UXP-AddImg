{
  "id": "cn.gapsun.hanxi.addimg",
  "name": "导入器",
  "version": "1.0.2",
  "author": "寒隙",
  "description": "常用图片快速置入工具，点击即可置入",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "request",
    "launchProcess": {
      "schemes": ["https", "http"]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "vanilla",
      "minimumSize": {
        "width": 200,
        "height": 100
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 230,
        "height": 400
      },
      "preferredFloatingSize": {
        "width": 230,
        "height": 400
      },
      "icons": [
        {
          "width": 32,
          "height": 32,
          "path": "icons/dark@1x.png",
          "scale": 1,
          "theme": "darkest"
        },
        {
          "width": 64,
          "height": 64,
          "path": "icons/dark@2x.png",
          "scale": 2,
          "theme": "darkest"
        }
      ],
      "label": {
        "default": "导入器"
      }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/dark@1x.png",
      "scale": 1,
      "theme": "darkest"
    },
    {
      "width": 46,
      "height": 46,
      "path": "icons/dark@2x.png",
      "scale": 2,
      "theme": "darkest"
    }
  ]
}
